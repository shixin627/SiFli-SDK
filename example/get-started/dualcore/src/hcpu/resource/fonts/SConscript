# for module compiling
import os
import re
import shutil
from building import *
import rtconfig

cwd = GetCurrentDir()

CPPDEFINES = []

if GetDepend('FREETYPE_TINY_FONT_FULL'):
    font_name = 'tiny55_full'
elif GetDepend('FREETYPE_TINY_FONT_LITE'):
    font_name = 'tiny55_lite'
elif GetDepend('FREETYPE_HANSANS_FONT'):
    font_name = 'SourceHanSansCN-Normal'
elif GetDepend('FREETYPE_ARIAL_FONT'):
    font_name = 'arial'
else:
    font_name = 'DroidSansFallback'

CPPDEFINES += ["FREETYPE_FONT_NAME={}".format(font_name)]

ttf_path = os.path.join(cwd, 'freetype', '{}.ttf'.format(font_name))

objs = []
if os.path.exists(ttf_path):
    var_name = re.sub(r'[^A-Za-z0-9_]', '_', font_name)

    # The TTF lives on NAND DFS at /assets/fonts/<name>.ttf, mirroring the
    # emoji layout (jsroot/assets/emoji/ -> /assets/emoji/ on watch).
    # FreeType opens it via FT_New_Face() (file mode) when font_lib_size == 0;
    # lv_freetype_font_init treats font_lib_data as a filesystem path then.
    # Saves ~1MB per OTA when only firmware changes (font sits in FS partition).
    #
    # NOTE: stub filename MUST NOT start with `lvsf_font_`. The HCPU link.sct
    # has a wildcard `lvsf_font_*.o (.rodata.*)` that scoops every .rodata in
    # such files into ER_IROM3, breaking main.bin into multiple ER_IROM*.bin.
    stub_path = os.path.join(cwd, 'freetype', 'font_partition_dsc.c')
    fs_font_path = '/assets/fonts/{}.ttf'.format(font_name)
    stub_content = '''/* AUTO-GENERATED by fonts/SConscript -- do not edit. */
#include "lvgl/lvgl.h"
#ifdef LV_USING_FREETYPE_ENGINE
#include "app_module.h"
#include "lvsf_ft_reg.h"

static const char {var}_name[] = "{name}";
const lv_font_freetype_lib_dsc_t {var}_lib = {{
    .font_lib_size = 0,                          /* 0 -> file mode */
    .font_lib_data = "{path}",
    .font_lib_name = {var}_name,
}};

LVSF_FREETYPE_FONT_REGISTER({var})

#endif
'''.format(var=var_name, name=font_name, path=fs_font_path)

    write_needed = True
    if os.path.exists(stub_path):
        with open(stub_path, 'r') as f:
            if f.read() == stub_content:
                write_needed = False
    if write_needed:
        with open(stub_path, 'w') as f:
            f.write(stub_content)

    # Drop the active TTF into <dualcore>/project/jsroot/assets/fonts/, the
    # same tree as jsroot/assets/emoji/ that's already pre-installed on the
    # watch. jsroot.bat (run separately) packages the whole jsroot tree into
    # a NAND FAT image and burns it; the watch's mnt_init() mounts FS_REGION
    # at "/", exposing /assets/fonts/<name>.ttf to FreeType file mode.
    jsroot_fonts = os.path.normpath(
        os.path.join(cwd, '..', '..', '..', '..', 'project', 'jsroot', 'assets', 'fonts'))
    os.makedirs(jsroot_fonts, exist_ok=True)
    out_ttf = os.path.join(jsroot_fonts, '{}.ttf'.format(font_name))
    if (not os.path.exists(out_ttf)
            or os.path.getmtime(ttf_path) > os.path.getmtime(out_ttf)):
        try:
            shutil.copyfile(ttf_path, out_ttf)
        except OSError:
            pass

    objs = Glob('freetype/font_partition_dsc.c')

if GetOption('no_cc'):
    objs = []

objs = DefineGroup('resource', objs, depend=['PKG_USING_LITTLEVGL2RTT'], CPPDEFINES=CPPDEFINES)

Return ('objs')
