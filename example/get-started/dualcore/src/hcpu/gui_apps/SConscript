# for module compiling
import os
from building import *
import rtconfig

cwd = GetCurrentDir()
list = os.listdir(cwd)
objs = []

if GetDepend('PKG_USING_LITTLEVGL2RTT'):
	objs = Glob('*.c')
	# CPPPATH = [cwd] so headers placed directly in gui_apps/ (e.g.
	# disp_refr_governor.h) are globally includable, matching how the
	# subdir SConscripts add their own dirs. (The previous '' resolved to
	# the build CWD via os.path.abspath('') and added nothing useful.)
	group = DefineGroup('App_watch_demo', objs, depend = ['PKG_USING_LITTLEVGL2RTT'], CPPPATH = [cwd], LOCAL_CCFLAGS = '')
	# PC simulator: skip apps that pull TFLite-Micro (gesture, dinosaur game),
	# WebRTC VAD (speech, skai), audio HAL (recorder, camera), or otherwise
	# tightly coupled to ARM-only peripherals. The rest of the app surface
	# (clock, main, setting, alarm, calculator, file_browser, ...) compiles.
	# hid_mouse removed from pc_skip (T1 part 3: ARM seam) — UI layer now
	# compiles under PC sim; ARM-only HID/motion calls are stubbed in
	# pc_link_stubs.c. bf0_hal includes #ifdef'd out for PC.
	pc_skip = ('gesture', 'speech', 'skai', 'recorder', 'camera',
	           'incoming_call', 'media', 'exercise', 'game') \
	          if GetDepend('BSP_USING_PC_SIMULATOR') else ()
	for d in list:
	    if d in pc_skip:
	        continue
	    path = os.path.join(cwd, d)
	    if os.path.isfile(os.path.join(path, 'SConscript')):
	        objs = objs + SConscript(os.path.join(d, 'SConscript'))
Return('objs')
