from building import *

cwd = GetCurrentDir()
src = []
path = [cwd]

if GetDepend('BSP_USING_SLEEP_FUSION'):
    # In-tree sleep classifier (Cole-Kripke + HR staging). Pure C, no
    # external lib. The driver lives in modules/service/sleep_service.c.
    src += ['sleep_fusion.c']
    group = DefineGroup('Health', src, depend = ['BSP_USING_SLEEP_FUSION'],
                        CPPPATH = path)
elif GetDepend('BSP_USING_SLEEP_VANHEES'):
    # In-tree accel-only sleep-PERIOD detector (van Hees arm-angle SIB).
    # Pure C, no external lib, no HR. Driver: modules/service/
    # sleep_vanhees_service.c. Mutually exclusive with sleep_fusion above.
    src += ['sleep_vanhees.c']
    group = DefineGroup('Health', src, depend = ['BSP_USING_SLEEP_VANHEES'],
                        CPPPATH = path)
else:
    group = DefineGroup('Health', [], depend = [''], CPPPATH = path)

Return('group')
