Import('RTT_ROOT')
Import('rtconfig')
import os
import sys
from building import * 

cwd = GetCurrentDir()

src = []
path = [cwd]

if GetDepend('BSP_USING_HR_SVC'):
    src += Glob('hr_service.c')

if GetDepend('BSP_USING_ACCE_SVC'):
    src += Glob('acce_service.c')

if GetDepend('BSP_USING_ALARM_MANAGER_SVC'):
    src += Glob('alarm_manager_service.c')

if GetDepend('BSP_USING_WATCHSYS_SVC'):
    src += Glob('watch_system_service.c')

if GetDepend('BSP_USING_SLEEP_FUSION'):
    # LCPU driver for the in-tree sleep_fusion classifier. Depends on
    # algorithm/health/sleep_fusion.{c,h} being built — that group is
    # also gated on BSP_USING_SLEEP_FUSION, so keep both in sync.
    src += Glob('sleep_service.c')

if GetDepend('BSP_USING_SLEEP_VANHEES'):
    # LCPU driver for the accel-only van Hees sleep-period detector. Depends
    # on algorithm/health/sleep_vanhees.{c,h} (also gated on the same flag).
    src += Glob('sleep_vanhees_service.c')

group = DefineGroup('Service', src, depend = [''], CPPPATH = path)

Return('group')
