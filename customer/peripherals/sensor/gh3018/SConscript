Import("rtconfig")
from building import *

cwd = GetCurrentDir()
src = Glob('*.c')
path = [cwd]
# Goodix only ships armclang-built .lib (Default_KEIL5_M33_hard-fp_fshort.lib).
# For GCC we skip the .lib and compile gh30x_gcc_stubs.c instead. For Keil the
# stubs would clash with .lib symbols, so remove the stub file. Pattern based
# on customer/peripherals/sensor/sc7r30/SConscript.
if rtconfig.CROSS_TOOL == "gcc":
    group = DefineGroup('Drivers', src, depend = ['HR_USING_GH3018'], CPPPATH = path)
else:
    SrcRemove(src, 'gh30x_gcc_stubs.c')
    lib = ['Default_KEIL5_M33_hard-fp_fshort']
    group = DefineGroup('Drivers', src, depend = ['HR_USING_GH3018'], LIBS = lib, CPPPATH = path, LIBPATH = path)

Return('group')
